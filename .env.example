# Core
DATABASE_URL=postgres://user:pass@localhost:5432/leadmarket
SESSION_SECRET=change-me-to-a-32-byte-random-string
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
LOG_LEVEL=info

# Replit OIDC auth (production)
ISSUER_URL=https://replit.com/oidc
REPL_ID=

# Distributed mode (Wave 1+). When unset, app runs in single-instance mode.
REDIS_URL=

# Stripe (per-lead wallet + subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# HMAC secret for inbound CRM webhooks (X-LCP-Signature: sha256=<hex>).
# Unset = dev/E2E pass-through; required in production (see prod-env validator).
CRM_WEBHOOK_SECRET=
# Per-provider native webhook signature secrets — optional. When set,
# they take precedence over CRM_WEBHOOK_SECRET for that provider.
HUBSPOT_WEBHOOK_SECRET=
GHL_WEBHOOK_SECRET=
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASS=
# Optional: Stripe Price IDs for the subscription tiers. When unset, inline
# product_data is used (creates a new Product per checkout — dev only).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# DNC compliance vendor (e.g., Gryphon, Convoso, RealPhoneValidation).
# When unset, a deterministic local fallback is used — DEV ONLY.
DNC_VENDOR_API_URL=
DNC_VENDOR_API_KEY=

# Email providers (digest + new-lead notifications). Configure ONE.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SEO signal sources (optional)
GSC_SITE_URL=
GSC_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Analytics 4 measurement ID. Baked into the client bundle at build
# time via Vite's VITE_* prefix. Leave unset for dev/CI so no analytics
# beacons fire; populate with a real G-XXXXXXXXXX in prod.
VITE_GA_MEASUREMENT_ID=

# CMS Plan Finder CSV URLs (optional — falls back to seed data)
CMS_TERMINATIONS_URL=
CMS_STAR_RATINGS_URL=
CMS_BENEFIT_CHANGES_URL=

# TrustedForm verification (Wave 2 — E2). When unset, leads are stored
# vendor-claimed but unverified.
TRUSTEDFORM_API_KEY=

# Vendor revenue share for disputes/refunds — decimal fraction (e.g. 0.6 = 60%).
# Defaults to 0.6 when unset. Clamped to [0, 1].
REV_SHARE_PCT=0.6

# Wave 6 — Exclusive vendor partnership rev-share override (M5). When a
# vendor.is_exclusive=true and no row-level override is set, this default
# decimal fraction (e.g. 0.75 = 75% to vendor) is applied. Defaults to 0.75.
REV_SHARE_PCT_EXCLUSIVE=0.75

# ──── Wave 6 — LLM backends (K3 conversation assist, T2 dispute classifier,
# T6 lead persona, D1 mediscore explainer, D5 outreach drafts, etc.) ────
# Configure ONE. When both are unset, a deterministic stub backend is
# used so dev + tests work without external services.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ──── Wave 6 — Twilio (K3 inline dialer + T7 SMS-first outreach) ────
# When unset, calls/SMS run in stub mode and return fake sids.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ──── Wave 6 — NIPR / DOI auto-verification (T4) ────
# When unset (not just empty), a stub verifier accepts any license number ≥ 6
# chars. An empty value means "intended live mode but misconfigured" — NIPR
# will 401 and the verifier fails closed instead of silently dropping into
# stub mode.
NIPR_API_KEY=
# Optional: override the live-mode request timeout (default 10s).
NIPR_TIMEOUT_MS=

# ──── Wave 6 — Feature flags ────
# Set any flag to "false" to disable that feature. All flags default ON.
FEATURE_LIVE_AUCTION=
FEATURE_TCPA=
FEATURE_DIALER=
FEATURE_CRM_SYNC=
FEATURE_REPUTATION=
FEATURE_REPLACEMENT_GUARANTEE=
FEATURE_AI_DISPUTE=
FEATURE_SMART_MATCH=
FEATURE_NIPR=
FEATURE_VENDOR_SCORECARD=
FEATURE_LEAD_PERSONA=
FEATURE_SMS_OUTREACH=
FEATURE_AUTO_DNC_RECHECK=
FEATURE_SURGE=
FEATURE_BUNDLES=
FEATURE_COVERAGE_HEATMAP=
FEATURE_LIVE_RADAR=
FEATURE_EXCLUSIVE_VENDORS=
FEATURE_SHARED_KANBAN=
FEATURE_SPEND_CAPS=
FEATURE_BULK_BUY=
FEATURE_ROUTING_RULES=
FEATURE_WHITE_LABEL=
FEATURE_PIPELINE_FORECAST=
FEATURE_MEDISCORE_EXPLAINER=
FEATURE_CALL_WINDOW=
FEATURE_NEWS_REENGAGEMENT=
FEATURE_AI_ENRICHMENT=
FEATURE_AI_OUTREACH=
FEATURE_CONVERSION_PLAYBOOK=
FEATURE_AGENT_DIRECTORY=
FEATURE_REFERRALS=
FEATURE_INTEGRATION_MARKETPLACE=
FEATURE_DATA_RETENTION=
# Daily prune of stale rows from the webhook_idempotency table. Default-on
# when the server boots; set to "false" to skip registering the cron.
FEATURE_IDEMPOTENCY_PRUNE=

# Observability — leave SENTRY_DSN unset to disable error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Integration tests: when LIVE_DB_TESTS=1 and DATABASE_URL points at a
# real Postgres, the suites under server/__integration__/ run end-to-end.
# Skipped by default so unit-only runs stay fast.
LIVE_DB_TESTS=
